<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Тип проєкту та платформа -->
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- Назви та ідентифікація -->
    <AssemblyName>fb2cng_Configurator</AssemblyName>
    <RootNamespace>fb2cng_FullConfig</RootNamespace>
    <!-- Компіляція та безпека типів -->
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Дозволити Unsafe код у проєкті (Виправляє SYSLIB1062 та CS0227) -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Керування DPI на рівні системи (PerMonitorV2) -->
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <!-- Публікація (Залежна від встановленого .NET 10 на цільовому ПК) -->
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>false</SelfContained>
    <!-- Програма використовуватиме встановлений .NET 10 на ПК, тому файл буде маленьким -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- Метадані файлу (Відображення у Властивості -> Деталі) -->
    <!-- Вимикаємо додавання коміту Git до версії -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Version>1.5</Version>
    <FileVersion>1.5.1.0</FileVersion>
    <Product>Toolkit for fb2cng</Product>
    <!-- ОПИС: Саме цей тег AssemblyTitle у Windows показує в полі "Опис файлу" -->
    <AssemblyTitle>YAML Configurator for fb2cng</AssemblyTitle>
    <Description>YAML Configurator for fb2cng</Description>
    <Company>Jurchos</Company>
    <Copyright>© 2026  Jurchos &amp; Gemini</Copyright>
    <!-- Ресурси -->
    <ApplicationIcon>icon_yaml.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="icon_yaml.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.9" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.9" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.9" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Properties\Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
    <Compile Update="Properties\Settings.Designer.cs">
      <DesignTimeSharedInput>True</DesignTimeSharedInput>
      <AutoGen>True</AutoGen>
      <DependentUpon>Settings.settings</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <None Update="Properties\Settings.settings">
      <Generator>SettingsSingleFileGenerator</Generator>
      <LastGenOutput>Settings.Designer.cs</LastGenOutput>
    </None>
  </ItemGroup>

</Project>